# Server port
PORT=5050

# MongoDB credentials
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password

# MongoDB connection URI
# Use "mongodb" as the host when running with Docker Compose.
# For local development, use "localhost" instead.
MONGODB_CONNECT_URI=mongodb://your_mongo_username:your_mongo_password@mongodb:27017/emr

# Default super admin account
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeStrong123!

# JWT access token
JWT_SECRET=your-access-token-secret-min-32-chars
JWT_EXPIRES_IN=15m

# JWT refresh token
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Application environment
NODE_ENV=development

# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173
